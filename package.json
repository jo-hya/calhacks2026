    "android:run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android.ps1 run",
    "android:devices": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android.ps1 devices",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.3.6"
  }
}
