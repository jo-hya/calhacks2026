# Copy to .env and fill in. Never commit .env.

# Claude agent (https://platform.claude.com/settings/keys). Without it, the scripted responder answers.
ANTHROPIC_API_KEY=
# POCKET_MODEL=claude-opus-5-5
# POCKET_EFFORT=medium           # low = faster replies
# POCKET_WEB_SEARCH=off          # disable web search for nearby alternatives
# POCKET_SMS_MAX_CHARS=129       # Bandwidth free trial limit; raise on a paid account

# Capital One Nessie sandbox
NESSIE_API_KEY=
NESSIE_ACCOUNT_ID=               # optional when an account is nicknamed "pocket"

# Bandwidth
BANDWIDTH_ACCOUNT_ID=
BANDWIDTH_APPLICATION_ID=
BANDWIDTH_PHONE_NUMBER=+1XXXXXXXXXX
BANDWIDTH_VERIFIED_PHONE_NUMBER=+1XXXXXXXXXX
BANDWIDTH_CLIENT_ID=
BANDWIDTH_CLIENT_SECRET=
BANDWIDTH_WEBHOOK_TOKEN=
